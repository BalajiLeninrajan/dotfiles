# Repository documentation and machine-local credentials.
README.md
.config/zsh/secrets.zsh

{{/* The student.cs login nodes are headless, shared, and root-less: shell,
     editor, and CLI tooling only. Every desktop config is dead weight there,
     and the home directory is on a quota'd NFS mount shared by every node. */}}
{{- $student := or (hasSuffix "student.cs.uwaterloo.ca" .chezmoi.fqdnHostname) (regexMatch "^/u[0-9]+/" .chezmoi.homeDir) }}

{{/* wintermute is a dev box reached over Tailscale. Agents and herdr run
     there and the only display is the one Chrome draws on, so it keeps the
     CLI and agent configs, herdr, and its systemd units, and nothing else. */}}
{{- $devbox := eq .chezmoi.hostname "wintermute" }}

