(defcfg
  process-unmapped-keys yes
)

(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defvar
  tap-time 200
  hold-time 200
)

(defchords ui-chord 50
  (u  ) u
  (  i) i
  (u i) ret
)

(defchords jk-chord 50
  (j  ) (tap-hold $tap-time $hold-time j rsft)
  (  k) (tap-hold $tap-time $hold-time k ralt)
  (j k) bspc
)

(defalias
  ;; --- Home Row Mods ---
  a (tap-hold $tap-time $hold-time a lctl)
  s (tap-hold $tap-time $hold-time s lmet)

  d (tap-hold $tap-time $hold-time d lalt)
  f (tap-hold $tap-time $hold-time f lsft)

  ui-u (chord ui-chord u)
  ui-i (chord ui-chord i)

  jk-j (chord jk-chord j)
  jk-k (chord jk-chord k)
  l (tap-hold $tap-time $hold-time l rmet)
  ; (tap-hold $tap-time $hold-time ; rctl)

  ;; --- Layer Helpers ---
  hrm (layer-switch base)
  nhrm (layer-switch qwerty)
  num (layer-switch num)

  ;; --- Special Keys ---
  spc (tap-hold $tap-time $hold-time spc (layer-toggle utl))
  numh (tap-hold $tap-time $hold-time lmet (layer-toggle num))
  cap (fork esc caps (lsft rsft))

  ;; --- Navigation Macros ---
  fwd C-rght
  bwd C-left
)

(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    @ui-u @ui-i o    p    [    ]    \
  @cap @a   @s   @d   @f   g    h    @jk-j @jk-k @l  @;   '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl @numh lalt          @spc           ralt rmet rctl
)

(deflayer num
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    S-1  S-2  S-3  S-4  S-5  S-6  S-7  S-8  S-9  S-0  _    _    _
  _    1    2    3    4    5    6    7    8    9    0    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  @numh _    _             @spc           _    _    _
)

(deflayer utl
  _    @hrm @nhrm @num _    _    _    _    _    _    mute vold volu _
  _    _    @fwd [    ]    S-9  S-0  pgup -    =     pp   prev next _
  _    _    _    pgdn _    _    left down up   right \    _    _
  _    _    _    _    _    @bwd _    _    _    _    _    _
  _    _    _              _              _    _    _
)

(deflayer qwerty
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @spc a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl @numh lalt          spc            ralt rmet rctl
)
