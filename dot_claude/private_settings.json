      {
        "hooks": [
          {
            "type": "http",
            "url": "http://127.0.0.1:47831/hook/local-claude-zellij-bridge-v1",
            "timeout": 2,
            "headers": {
              "X-Zellij-Session": "$ZELLIJ_SESSION_NAME",
              "X-Zellij-Pane": "$ZELLIJ_PANE_ID"
            },
            "allowedEnvVars": [
              "ZELLIJ_SESSION_NAME",
