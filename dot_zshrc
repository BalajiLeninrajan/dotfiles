st-run() {
    # 1. Automatically find the project name from the .project file
    if [ ! -f .project ]; then
        echo "Error: No .project file found in this directory!"
        return 1
    fi
    
    local PROJ_NAME=$(grep -oPm1 "(?<=<name>)[^<]+" .project)
    echo "--- Detected Project: $PROJ_NAME ---"

    # 2. Build (Import ensures new files are tracked)
    $ST_IDE -nosplash -application org.eclipse.cdt.managedbuilder.core.headlessbuild \
    -data /tmp/st_ws -import . -build "$PROJ_NAME"

    if [ $? -eq 0 ]; then
        # 3. Find the .elf file (handles different build folder names)
        local ELF_FILE=$(find Debug -name "*.elf" | head -n 1)
        
        if [ -z "$ELF_FILE" ]; then
            echo "Error: Could not find .elf file in Debug/ folder."
            return 1
        fi

        echo "--- Flashing $ELF_FILE ---"
        $ST_PROG -c port=SWD -w "$ELF_FILE" -v -rst
    else
        echo "Build failed. Check logs above."
        return 1
    fi
}

