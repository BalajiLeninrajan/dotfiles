#!/bin/sh
# Run a TUI in its own Ghostty window, one instance per app.
# usage: term-app <command> [args...]
#
# The window's app-id is com.mitchellh.ghostty.<command>, so niri and the
# launcher tell it apart from a plain terminal, and it matches the desktop
# entry of the same name. A second launch focuses the window already open.

app=${1:?usage: term-app <command> [args...]}
id="com.mitchellh.ghostty.$app"

win=$(niri msg -j windows 2>/dev/null |
    jq -r --arg id "$id" 'first(.[] | select(.app_id == $id) | .id) // empty')
if [ -n "$win" ]; then
    exec niri msg action focus-window --id "$win"
fi

# Apps started from the desktop never source .zshrc, so they miss its EDITOR
# and fall back to nano.
export EDITOR=nvim VISUAL=nvim

# The main Ghostty config sends ESC CR for shift+enter, which the app reads as
# alt+enter. Unbind it here so the app gets a real shift+enter.
exec ghostty --class="$id" --gtk-single-instance=false \
    --keybind=shift+enter=unbind -e "$@"
