{{- /* wintermute is a dev box with no chat, mail, or calendar accounts, so
       it opens nothing at login. */ -}}
{{ if eq .chezmoi.hostname "wintermute" -}}
#!/bin/sh
exit 0
{{ else -}}
#!/bin/sh
# Lay out workspace 1 at login. Two tabbed columns:
#   discordo | aerc
#   iamb     | ikhal
#
# New windows open in a column right of the focused one, so each second app
# spawns as its own column, then moves left into the column before it.

term_app="$HOME/.local/bin/term-app"

# Print the id of the window with app-id com.mitchellh.ghostty.$1 once it
# appears. Gives up after 10 seconds.
wait_for() {
    i=0
    while [ "$i" -lt 100 ]; do
        id=$(niri msg -j windows 2>/dev/null |
            jq -r --arg id "com.mitchellh.ghostty.$1" \
                'first(.[] | select(.app_id == $id) | .id) // empty')
        [ -n "$id" ] && { echo "$id"; return 0; }
        i=$((i + 1))
        sleep 0.1
    done
    return 1
}

column() {
    "$term_app" "$1" &
    top=$(wait_for "$1") || return
    "$term_app" "$2" &
    bottom=$(wait_for "$2") || return
    niri msg action consume-or-expel-window-left --id "$bottom"
    niri msg action focus-window --id "$top"
    niri msg action set-column-display tabbed
}

# Let DMS finish loading first. It compiles its UI on one core for 12s or
# more, and four terminal apps starting beside it stretch that out. Give up
# after 2 minutes so a broken shell can't keep the apps from opening.
if systemctl --user -q is-enabled dms.service 2>/dev/null; then
    timeout 120 sh -c 'until systemctl --user -q is-active dms.service; do sleep 0.5; done'
fi

niri msg action focus-workspace 1
column discordo iamb
column aerc ikhal
niri msg action focus-column-first
{{ end -}}
