layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="zjstatus" {
                format_left  "{tabs}"
                format_right "#[bg=#1e1e2e]"
                format_space "#[bg=#1e1e2e]"

                tab_normal   "#[fg=#6c7086,bg=#1e1e2e] {index} {name} "
                tab_active   "#[fg=#cba6f7,bg=#1e1e2e,bold] {index} {name} "
            }
        }
    }
    tab
}
