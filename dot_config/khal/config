# Calendars that vdirsyncer keeps in ~/.local/share/calendars.
# DMS's calendar card reads events through khal too.

[calendars]

[[portal]]
path = ~/.local/share/calendars/portal/
readonly = True
color = '#f9e2af'

[[warg]]
path = ~/.local/share/calendars/warg/
readonly = True
color = '#cba6f7'

# One calendar per Google calendar, named as in Google. All of them are green;
# vdirsyncer only copies the names, since a synced color would win over this.
[[google]]
path = ~/.local/share/calendars/google/*
type = discover
color = '#a6e3a1'

[locale]
timeformat = %H:%M
dateformat = %Y-%m-%d
longdateformat = %Y-%m-%d
datetimeformat = %Y-%m-%d %H:%M
longdatetimeformat = %Y-%m-%d %H:%M

[view]
# Time and title only. The description, like the course name on Portal
# events, shows when an event is selected.
agenda_event_format = '{calendar-color}{cancelled}{start-end-time-style} {title}{repeat-symbol}{alarm-symbol}{reset}'

# ikhal in Catppuccin Mocha, mauve accent. No backgrounds except on focus and
# selection, so the terminal's own Mocha base shows through. Each entry is
# fg, bg, mono, fg_high, bg_high; ikhal runs in truecolor, so only the last two
# matter here.
#
#   text     #cdd6f4   subtext0 #a6adc8   overlay1 #7f849c   overlay0 #6c7086
#   surface2 #585b70   surface1 #45475a   surface0 #313244
#   mantle   #181825   crust    #11111b
#   mauve    #cba6f7   lavender #b4befe   green    #a6e3a1   red      #f38ba8
[palette]
header = '', '', '', '#cdd6f4', '#181825'
