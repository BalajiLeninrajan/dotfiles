{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ],
  "background": "canvas",
  "terminal_padding": [
    6,
    4
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 268
      },
      "min": 44,
      "max": 480,
      "background": "chrome",
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 46
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome-mine"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "spaces-mine"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents-mine"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 50
          },
          "content": {
            "mod": "workspace-chrome-mine",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "resizable": false,
      "children": [
        {
          "id": "work-top",
          "type": "row",
          "size": {
            "px": 24
          },
          "background": "background",
          "children": []
        },
        {
          "id": "work-body",
          "type": "row",
          "padding": 0,
          "gap": 0,
          "children": [
            {
              "id": "work-left",
              "type": "row",
              "size": {
                "px": 8
              },
              "background": "background",
              "children": []
            },
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "gap": 8,
                  "radius": 8,
                  "background": "background",
                  "lone": false,
                  "border": {
                    "width": 0.5,
                    "color": "border"
                  },
                  "focus": {
                    "width": 0.5,
                    "color": "accent"
                  }
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "hidden": true,
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "files",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "work-right",
              "type": "row",
              "size": {
                "px": 14
              },
              "background": "background",
              "children": []
            }
          ],
          "resizable": false
        },
        {
          "id": "work-bottom",
          "type": "row",
          "size": {
            "px": 10
          },
          "background": "background",
          "children": []
        },
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 50
          },
          "window_drag": true,
          "content": {
            "mod": "tabs-mine"
          }
        }
      ],
      "background": "background"
    }
  ]
}
