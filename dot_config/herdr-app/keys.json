{
  "global": {
    "ctrl-f": "mod.open:prefix",
    "ctrl-+": "app.zoom_in",
    "ctrl--": "app.zoom_out",
    "ctrl-0": "app.zoom_reset",
    "ctrl-=": "app.zoom_in",
    "ctrl-1": "tab.select:1",
    "ctrl-2": "tab.select:2",
    "ctrl-3": "tab.select:3",
    "ctrl-4": "tab.select:4",
    "ctrl-5": "tab.select:5",
    "ctrl-6": "tab.select:6",
    "ctrl-7": "tab.select:7",
    "ctrl-8": "tab.select:8",
    "ctrl-9": "tab.select:9",
    "ctrl-pagedown": "tab.next",
    "ctrl-pageup": "tab.prev",
    "ctrl-tab": "tab.next",
    "ctrl-shift-tab": "tab.prev",
    "ctrl-shift-pagedown": "space.next",
    "ctrl-shift-pageup": "space.prev",
    "ctrl-?": "app.help",
    "ctrl-shift-/": "app.help",
    "ctrl-shift-?": "app.help",
    "ctrl-shift-b": "mod.open:sidebar-toggle",
    "ctrl-shift-n": "space.new",
    "ctrl-shift-t": "tab.new",
    "ctrl-shift-k": "mod.open:picker",
    "ctrl-shift-p": "app.palette",
    "ctrl-,": "app.settings",
    "ctrl-shift-o": "pane.split:right",
    "ctrl-shift-e": "pane.split:down",
    "ctrl-shift-w": "tab.close",
    "ctrl-shift-x": "pane.close",
